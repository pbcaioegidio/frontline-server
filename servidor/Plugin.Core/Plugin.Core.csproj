<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Plugin.Core</AssemblyName>
    <RootNamespace>Plugin.Core</RootNamespace>
    <Version>1.1.25163.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseSystemDrawing>true</UseSystemDrawing>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="AssemblyInfo.cs;Properties\AssemblyInfo.cs;Colorful\console_refactored.cs;Utility\bitwise_deobfuscated.cs;Utility\cryptosyncer_deobfuscated.cs;Utility\cryptoutils_deobfuscated.cs;XML\permission_refactored.cs;XML\templatepack_refactored.cs" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" /> <!-- fix: M.E.DI.Abstractions net8.0 refs 8.0.0.0 but declares no net8.0 dep; explicit ref puts it in the graph so the runtime stops probing the stale net48 dll and DB init works -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="Npgsql" Version="8.0.4" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
</Project>
