<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FrontLine-Setup-Store</AssemblyName>
    <RootNamespace>FrontLineBootstrap</RootNamespace>
    <Version>1.0.0</Version>
    <Product>FrontLine Setup (Store)</Product>
    <Company>FrontLine</Company>
    <Description>Bootstrapper: baixa o instalador Full e executa o Setup.</Description>
  </PropertyGroup>
</Project>
