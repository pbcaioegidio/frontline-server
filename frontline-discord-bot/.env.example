# Lavalink v4 privado (serviço `lavalink` no docker-compose — rede interna)
# Senha só no .env da VPS (nunca commit). Actions usam secrets + SSH.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASS=troque-esta-senha
LAVALINK_SECURE=false

